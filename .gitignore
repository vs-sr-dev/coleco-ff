# =====================================================================
#  coleco-ff -- BYOA. Nothing from the original game goes in git.
#  Everything below the "generated" headers is produced on your machine
#  by tools/import_assets.ps1 from your own ROM.
# =====================================================================

# --- Third-party tools, firmware, and your own game files ------------
/z88dk/
/z88dk-*.zip
/CoolCV/
/bios/
/mame_roms/
/FF1Disassembly-master/
*.nes
*.col
*.rom
*.sav

# --- Build outputs and emulator state ---------------------------------
/build/
/snap/
/cfg/
/data/

# --- Generated from the ROM (tools/import_assets.ps1) -----------------
/src/ff1_*.h
/src/ff1_*.bin
/src/data/
/src/songs/
/src/battle_song.h

# --- Generated by the build (tools/build_all.ps1) ---------------------
/src/*_symbols.h

# --- Earlier slices: development history, not part of the build -------
# Each slice is a full copy of the main program. Only the current one is
# tracked; when the next slice is started, move the exception below.
/src/slice*.c
!/src/slice78.c
/src/*.c.asm
/src/ovl_audio.c
/src/ovl_demo.c

# --- Tool outputs and third-party transcriptions ----------------------
/tools/*.c
/tools/*.json
/tools/local.ps1

# --- Third-party documents and working notes --------------------------
/docs/*GameFAQs*
/docs/hqdefault.jpg
/docs/portfolio/
/docs/next_session.md
/docs/enemies_next_session.md

# --- Local editor / agent settings -------------------------------------
/.claude/
/.vscode/
